<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- QR invite scanning (mobile_scanner, §5a). -->
    <!-- Required for the embedded Tor transport (and all networking) in RELEASE builds. Flutter
         only auto-injects INTERNET into the debug/profile manifests, so without this line release
         APKs are denied every outbound socket (EPERM) and Tor can never bootstrap. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"
    />
    <!-- New-message notifications (flutter_local_notifications, Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opt-in background delivery foreground service (flutter_foreground_task, §11.8 / #13):
         keeps the process alive so the Tor peek keeps running while backgrounded. -->
    <!-- Background delivery after a reboot or an app update (BootReceiver, §11.8). It acts only
         while the user has background delivery on. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Screenshot transparency (#1): lets the app be told when the user screenshots a chat, so it
         can log it and tell the peer. Android 14+ only, and it reports *that* a screenshot happened
         — never its contents, and never a photo taken of the screen. Normal permission: no prompt,
         and no ability to read any screen content. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <!-- Android 15+: told whether this app's window is being screen-recorded, so the open chat can
         tell the contact (as for a screenshot). A normal permission: no prompt. -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <!-- Strip permissions that transitive plugins merge in but Night Drop never uses. Keeping the
         permission set minimal matters for a privacy-first app (and for the F-Droid listing). Each
         is injected by a dependency, not by us; tools:node="remove" deletes it from the merged
         manifest. Verified against app/lib usage:
           - RECORD_AUDIO          (camera_android_camerax): camera is QR-scan only, no mic/voice.
           - WRITE_EXTERNAL_STORAGE (camera_android_camerax): file saving uses file_picker+SAF.
           - READ_EXTERNAL_STORAGE / READ_MEDIA_{IMAGES,VIDEO,AUDIO} (open_filex): attaching uses
             file_picker (SAF), opening hands the file to another app via intent — neither needs
             this app to hold media-read perms. Confirmed by device test of attach/open flows. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" tools:node="remove" />

    <!-- No Android backup of any app data: allowBackup for Android 11 and older, the rules file
         for 12+ (cloud backup and device-to-device transfer). See res/xml/data_extraction_rules.xml. -->
    <application
        android:label="${appName}"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
    >
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
        >
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
            />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data android:name="flutterEmbedding" android:value="2" />
        <!-- Background-delivery foreground service (flutter_foreground_task, #13): it keeps the Tor
             peek alive so messages arrive while the app is off screen. It never uploads anything
             to a server.

             specialUse, NOT dataSync. Android 15 caps a `dataSync` foreground service at six
             cumulative hours per 24, then calls onTimeout and the system stops it — measured at
             exactly 6h 0m 0s 20ms on an S25 (API 36) on 2026-08-09, after which the app sat cached
             for five hours receiving nothing. Nothing told the user, and it does not come back
             until the app is reopened, so "keeps checking for messages" became false overnight
             with no way to notice. A messenger holding an anonymity-network connection is not a
             data-sync job and must not be budgeted as one.

             The cost of this type is that Google Play requires a written justification for it. We
             do not ship on Play — F-Droid, GitHub releases and the onion site are unaffected — so
             the trade is a permission reviewers may ask about (answered by the subtype below)
             against background delivery that actually stays on. -->
        <!-- stopWithTask="false": swiping the app away must not stop delivery. With "true" Android
             stops the service itself on a swipe and never calls onTaskRemoved, so the plugin's own
             stopWithTask option cannot override it. MainActivity keeps the engine alive for the
             same reason, and Exit in the menu is how the user stops everything (issue #15). -->
        <!-- Restarts the engine (and with it the Tor core and the foreground service) after a reboot
             or an update, when background delivery is on. See BootReceiver.kt. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The plugin's own boot receiver restarts only the service, never the engine that runs
             the core (BootReceiver.kt says why that is wrong); it is inert with autoRunOnBoot off,
             and removed so the app has one boot path. -->
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            tools:node="remove" />
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains the user's own anonymous Tor onion service so that
                    end-to-end encrypted peer-to-peer messages can be received while the app is not
                    on screen. Night Drop has no push service and no account server: there is
                    nothing that could wake the app on a message's behalf, so the connection must
                    be held by the device itself." />
        </service>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
